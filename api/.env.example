APP_ENV=development
LOG_LEVEL=debug
HOST=0.0.0.0
PORT=8080
WEB_BASE_URL=http://localhost:5173

DATABASE_URL=postgres://kickoutchi:kickoutchi@localhost:5432/kickoutchi?sslmode=disable

HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_READY_TIMEOUT=2s
HTTP_SHUTDOWN_TIMEOUT=10s

DB_MAX_CONNS=10
DB_MIN_CONNS=0
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
DB_HEALTH_CHECK_PERIOD=30s
DB_CONNECT_TIMEOUT=5s

SESSION_COOKIE_NAME=kickoutchi_session
SESSION_TTL=720h
SESSION_REFRESH_WINDOW=24h
PASSWORD_RESET_TOKEN_TTL=1h
EMAIL_VERIFICATION_TOKEN_TTL=24h
OAUTH_STATE_TTL=10m
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

AUTH_IP_RATE_LIMIT_REQUESTS=30
AUTH_IP_RATE_LIMIT_WINDOW=1m
AUTH_IP_RATE_LIMIT_BURST=10
AUTH_ACCOUNT_RATE_LIMIT_REQUESTS=5
AUTH_ACCOUNT_RATE_LIMIT_WINDOW=5m
AUTH_ACCOUNT_RATE_LIMIT_BURST=3
CSRF_ALLOWED_ORIGINS=http://localhost:5173

RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_API_BASE_URL=https://api.resend.com

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=

R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_PUBLIC_BASE_URL=
R2_SIGNED_UPLOAD_TTL=10m

SEED_DEFAULT_PASSWORD=
SEED_ALLOW_NON_DEV=false

ARGON2_MEMORY=19456
ARGON2_TIME=2
ARGON2_THREADS=1
ARGON2_KEY_LENGTH=32
ARGON2_SALT_LENGTH=16
