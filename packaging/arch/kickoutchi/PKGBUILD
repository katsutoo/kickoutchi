# Maintainer: nugget <vincent@sshmoi.com>

pkgname=kickoutchi
pkgver=0.1.0
pkgrel=1
pkgdesc="A clean TUI and CLI port janitor"
arch=("x86_64" "aarch64")
url="https://github.com/nuggocto/kickoutchi"
license=("MIT")
depends=("gcc-libs")
makedepends=("cargo")
conflicts=("kickoutchi-bin")
options=("!debug")
source=("${pkgname}-${pkgver}.tar.gz::${url}/releases/download/v${pkgver}/source.tar.gz")
sha256sums=("43e44d9892fe4394f173cadd6bf7c2e8e9f2de862cb8f7cf0d7e600b0b0caa66")

prepare() {
  cd "${pkgname}-${pkgver}"
  cargo fetch --locked
}

build() {
  cd "${pkgname}-${pkgver}"
  cargo build --frozen --release --all-features --bin kickoutchi --bin kick
}

check() {
  cd "${pkgname}-${pkgver}"
  cargo test --frozen --all-features
}

package() {
  cd "${pkgname}-${pkgver}"
  install -Dm755 "target/release/kickoutchi" "${pkgdir}/usr/bin/kickoutchi"
  install -Dm755 "target/release/kick" "${pkgdir}/usr/bin/kick"
  install -Dm644 "LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 "README.md" "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  install -Dm644 "CHANGELOG.md" "${pkgdir}/usr/share/doc/${pkgname}/CHANGELOG.md"
}
