+#[derive(Debug)]
+struct SocketIndex {
+    source_index: usize,
+    owner_indices: Vec<usize>,
+    owner_completeness: &'static str,
+    owner_reasons: Vec<&'static str>,
+    omitted_owner_count: u64,
