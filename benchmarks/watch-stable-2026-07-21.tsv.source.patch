+            .arg("--config")
+            .arg(&config_path)
+            .args(args)
+            .stdout(Stdio::piped())
+            .stderr(Stdio::piped())
+            .spawn()
+            .expect("kickoutchi binary must run with explicit config");
+        let mut child = ChildGuard { child };
+        let deadline = Instant::now() + KICK_EXIT_WAIT;
+        let status = loop {
+            if let Some(status) = child
+                .child
+                .try_wait()
+                .expect("watch exit status must be readable")
+            {
+                break status;
+            }
+            assert!(
